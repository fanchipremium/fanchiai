  "layout_structure": {
    "header": {
      "type": "Fixed glassmorphism topbar",
      "components": ["Text Logo 'FANCHI' with italic AI Wrap badge", "Gemini AI Engine indicator badge", "Catalog Quick Filter", "Reset Studio Button"]
    },
    "main_container": {
      "type": "2-Column Studio Layout on Desktop (Upload/Catalog Left, Interactive Before/After Visualizer Right)",
      "left_panel": {
        "step_1": "Car Photo Drag & Drop Upload Zone + Photo Consent Checkbox",
        "step_2": "FANCHI Vinyl Product Selector (Filter Tabs by Material/Finish, Search Bar, Visual Swatches Grid)",
        "step_3": "GENERATE VISUAL CTA Button (with laser scan motion on loading state)"
      },
      "right_panel": {
        "result_container": "Interactive Before/After Slider + Side-by-Side Toggle View",
        "actions": ["TRY ANOTHER COLOR Button (re-uses uploaded photo)", "DOWNLOAD HIGH-RES VISUAL Button", "SHARE WRAP LOOK Button"],
        "wrap_info_card": "Summary of active FANCHI material, finish, color code & estimated roll spec (1.52m x 16.5m)"
      }
    },
    "error_states": [
      {
        "type": "General API Failure",
        "message": "Unable to generate your FANCHI wrap visual right now. Please try again.",
        "button_text": "TRY AGAIN",
        "data_testid": "error-general-try-again-button"
      },
      {
        "type": "Server Overload",
        "message": "FANCHI AI is currently busy. Please try again in a moment.",
        "button_text": "RETRY NOW",
        "data_testid": "error-busy-retry-button"
      }
    ]
